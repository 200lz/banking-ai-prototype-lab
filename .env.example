# Local mode needs no secrets. Do not paste real customer data into this demo.
AGENT_MODE=local
RETRIEVAL_BACKEND=local
API_AUTH_MODE=local
API_BASE_URL=http://127.0.0.1:8000
WEB_AUTH_MODE=local
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Illustrative USD per million tokens; review region/model pricing before use.
BEDROCK_INPUT_USD_PER_MILLION=0.06
BEDROCK_OUTPUT_USD_PER_MILLION=0.24
# Optional OTLP HTTP collector; never enable plaintext prompt logging.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# CORPUS_BUCKET=your-private-corpus-bucket
# CORPUS_PREFIX=corpus/
# AUDIT_TABLE=your-audit-table

# Read-only governed synthetic financial profiles. Local mode reads published Gold.
FINANCIAL_BACKEND=local
FINANCIAL_MAX_AGE_DAYS=45
# For a configured Databricks AWS workspace, use unified auth/secret providers.
# FINANCIAL_BACKEND=databricks
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_WAREHOUSE_ID=<your-sql-warehouse-id>
# DATABRICKS_CATALOG=<your-approved-catalog>
# DATABRICKS_SCHEMA=banking_ai_synthetic
# Never store DATABRICKS_TOKEN, client secrets, or AWS keys in committed files.
